msgid_plural "%(num)d jours restants"
msgstr[0] "noch %(num)d Tag"
msgstr[1] "noch %(num)d Tage"

msgid "%(num)d planification cette semaine"
msgid_plural "%(num)d planifications cette semaine"
msgstr[0] "%(num)d Planung diese Woche"
msgstr[1] "%(num)d Planungen diese Woche"

msgid "%(num)d page"
