msgid "Accès illimité"
msgstr "Accesso illimitato"

msgid "Gérer mon abonnement App Store"
msgstr "Gestisci il mio abbonamento App Store"

msgid "Ou sur l'iPad / l'iPhone : Réglages > [votre nom] > Abonnements."
msgstr "Oppure sull'iPad / iPhone: Impostazioni > [il tuo nome] > Abbonamenti."

msgid "Choisissez un abonnement pour utiliser ProfCalendar."
msgstr "Scegli un abbonamento per usare ProfCalendar."

msgid "Utiliser un bon"
msgstr "Usa un buono"

msgid "Si vous avez reçu un code promotionnel, entrez-le ci-dessous pour activer votre accès Premium."
msgstr "Se hai ricevuto un codice promozionale, inseriscilo qui sotto per attivare il tuo accesso Premium."

msgid "Entrez votre code"
msgstr "Inserisci il tuo codice"

msgid "Appliquer"
msgstr "Applica"

msgid "Exporter mes données"
msgstr "Esporta i miei dati"

msgid "Conformément à la nLPD et au RGPD, vous pouvez télécharger l'ensemble de vos données personnelles (compte, classes, élèves) au format JSON."
msgstr "In conformità con la nLPD e il GDPR, puoi scaricare tutti i tuoi dati personali (account, classi, allievi) in formato JSON."

msgid "Télécharger mes données"
msgstr "Scarica i miei dati"

msgid "Cette action est irréversible !"
msgstr "Questa azione è irreversibile!"

msgid "La suppression de votre compte entraînera la perte définitive de toutes vos données : classes, élèves, évaluations, notes, remarques, sanctions, planifications, et fichiers."
msgstr "L'eliminazione del tuo account comporterà la perdita definitiva di tutti i tuoi dati: classi, allievi, valutazioni, voti, osservazioni, sanzioni, pianificazioni e file."

msgid "<strong>Abonnement App Store :</strong> supprimer votre compte ne résilie pas l'abonnement pris sur l'App Store. Résiliez-le d'abord dans Réglages > [votre nom] > Abonnements > ProfCalendar, ou <a href=\"https://apps.apple.com/account/subscriptions\" target=\"_blank\" rel=\"noopener\">ouvrez vos abonnements Apple</a>."
msgstr "<strong>Abbonamento App Store:</strong> eliminare il tuo account non disdice l'abbonamento sottoscritto sull'App Store. Disdicilo prima in Impostazioni > [il tuo nome] > Abbonamenti > ProfCalendar, oppure <a href=\"https://apps.apple.com/account/subscriptions\" target=\"_blank\" rel=\"noopener\">apri i tuoi abbonamenti Apple</a>."

msgid "Si vous êtes maître de classe et que des enseignants spécialisés sont liés à vos classes, un rapport PDF contenant les données des élèves (notes, remarques, sanctions) leur sera automatiquement envoyé avant la suppression."
msgstr "Se sei docente di classe e dei docenti specialisti sono collegati alle tue classi, prima dell'eliminazione riceveranno automaticamente un rapporto PDF con i dati degli allievi (voti, osservazioni, sanzioni)."

msgid "Confirmez avec votre mot de passe :"
msgstr "Conferma con la tua password:"

msgid "Supprimer définitivement mon compte"
msgstr "Elimina definitivamente il mio account"

msgid "Erreur lors de la sauvegarde des paramètres : {error}"
msgstr "Errore durante il salvataggio delle impostazioni: {error}"

msgid "Une erreur est survenue. Veuillez réessayer."
msgstr "Si è verificato un errore. Riprova."

msgid "Les nouveaux mots de passe ne correspondent pas."
msgstr "Le nuove password non corrispondono."

msgid "Le nouveau mot de passe doit contenir au moins 8 caractères."
msgstr "La nuova password deve contenere almeno 8 caratteri."

msgid "Veuillez entrer votre mot de passe."
msgstr "Inserisci la tua password."

msgid "Masquer le tutoriel"
msgstr "Nascondi il tutorial"

msgid "Veuillez entrer un code à 6 chiffres."
msgstr "Inserisci un codice a 6 cifre."

msgid "Voulez-vous vraiment désactiver la double authentification ?"
msgstr "Vuoi davvero disattivare l'autenticazione a due fattori?"

msgid "Êtes-vous sûr de vouloir supprimer votre compte ? Cette action est IRRÉVERSIBLE."
msgstr "Vuoi davvero eliminare il tuo account? Questa azione è IRREVERSIBILE."

msgid "DERNIÈRE CONFIRMATION : Toutes vos données seront définitivement supprimées. Continuer ?"
msgstr "ULTIMA CONFERMA: tutti i tuoi dati saranno eliminati definitivamente. Continuare?"

msgid "Suppression en cours..."
msgstr "Eliminazione in corso..."

msgid "Aucun niveau. Enregistrez une première fois pour obtenir l'échelle par défaut, ou ajoutez les vôtres."
msgstr "Nessun livello. Salva una prima volta per ottenere la scala predefinita, oppure aggiungi i tuoi."

msgid "Impossible de charger l'échelle."
msgstr "Impossibile caricare la scala."

msgid "Supprimer ce niveau ? Les appréciations qui l'utilisaient repasseront à « aucune »."
msgstr "Eliminare questo livello? I giudizi che lo usavano torneranno a «nessuno»."

msgid "OK"
msgstr "OK"

msgid "En savoir plus"
msgstr "Scopri di più"

msgid "ProfCalendar n'utilise que des cookies essentiels (session, connexion). Aucun cookie publicitaire."
msgstr "ProfCalendar usa solo cookie essenziali (sessione, accesso). Nessun cookie pubblicitario."

msgid "Essayer gratuitement 14 jours"
msgstr "Prova gratis per 14 giorni"

msgid "Explorer la démo"
msgstr "Esplora la demo"

msgid "Rien à payer pendant 14 jours, sans engagement."
msgstr "Niente da pagare per 14 giorni, senza vincoli."

msgid "puis dès CHF 4.90 par mois, sans engagement."
msgstr "poi da CHF 4.90 al mese, senza vincoli."

msgid "Rien à payer aujourd’hui. Annulez avant la fin de l’essai (Réglages > votre nom > Abonnements) et vous ne payez rien. Nous vous envoyons un rappel deux jours avant."
msgstr "Niente da pagare oggi. Disdici prima della fine della prova (Impostazioni > il tuo nome > Abbonamenti) e non paghi nulla. Ti mandiamo un promemoria due giorni prima."

msgid "Vous recevez un rappel par e-mail avant la fin de l’essai."
msgstr "Ricevi un promemoria via e-mail prima della fine della prova."

msgid "14 jours gratuits, puis facturé chaque mois"
msgstr "14 giorni gratis, poi addebito mensile"

msgid "14 jours gratuits, puis CHF 3.33/mois"
msgstr "14 giorni gratis, poi CHF 3.33/mese"

msgid "Essai gratuit de 14 jours"
msgstr "Prova gratuita di 14 giorni"

msgid "votre carte est demandée, mais rien n'est débité avant la fin de l'essai. Résiliez avant cette date depuis Paramètres > Abonnement et vous ne payez rien."
msgstr "ti viene chiesta la carta, ma non viene addebitato nulla prima della fine della prova. Disdici prima di quella data da Impostazioni > Abbonamento e non paghi nulla."

msgid "Commencez par créer vos classes"
msgstr "Inizia creando le tue classi"

msgid "Cette page se remplit dès que vos classes et votre horaire sont en place. Cela prend environ deux minutes."
msgstr "Questa pagina si riempie non appena le tue classi e il tuo orario sono pronti. Ci vogliono circa due minuti."

msgid "Mode démonstration : rien n'est enregistré. Créez votre compte pour utiliser ProfCalendar avec vos classes."
msgstr "Modalità dimostrativa: nulla viene salvato. Crea il tuo account per usare ProfCalendar con le tue classi."

msgid "Voir comment faire en vidéo"
msgstr "Guarda come fare in video"

msgid "La démonstration est momentanément indisponible."
msgstr "La demo è temporaneamente non disponibile."

msgid "Le calendrier fait partie de l’abonnement."
msgstr "Il calendario fa parte dell'abbonamento."

msgid "La page du cours fait partie de l’abonnement."
msgstr "La pagina della lezione fa parte dell'abbonamento."

msgid "La gestion de classe fait partie de l’abonnement."
msgstr "La gestione della classe fa parte dell'abbonamento."

msgid "Le gestionnaire de fichiers fait partie de l’abonnement."
msgstr "La gestione dei file fa parte dell'abbonamento."

msgid "L’horaire type fait partie de l’abonnement."
msgstr "L'orario tipo fa parte dell'abbonamento."

msgid "Le tableau de bord fait partie de l’abonnement."
msgstr "Il pannello principale fa parte dell'abbonamento."

msgid "Voir le calendrier du compte d’exemple"
msgstr "Vedi il calendario dell'account di esempio"

msgid "Voir la page du cours du compte d’exemple"
msgstr "Vedi la pagina della lezione dell'account di esempio"

msgid "Voir la gestion de classe du compte d’exemple"
msgstr "Vedi la gestione della classe dell'account di esempio"

msgid "Voir les fichiers du compte d’exemple"
msgstr "Vedi i file dell'account di esempio"

msgid "Voir l’horaire du compte d’exemple"
msgstr "Vedi l'orario dell'account di esempio"

msgid "Voir le tableau de bord du compte d’exemple"
msgstr "Vedi il pannello dell'account di esempio"

msgid "Avant de vous abonner, regardez comment cela fonctionne sur un compte d’exemple déjà rempli : vous pouvez tout explorer, rien n’est enregistré."
msgstr "Prima di abbonarti, guarda come funziona su un account di esempio già compilato: puoi esplorare tutto, nulla viene salvato."

msgid "Envie de voir l’app avant de vous abonner ?"
msgstr "Vuoi vedere l'app prima di abbonarti?"

msgid "Explorez un compte d’exemple déjà rempli : calendrier, page du cours, notes et plan de classe. Rien n’est enregistré."
msgstr "Esplora un account di esempio già compilato: calendario, pagina della lezione, voti e piano dei posti. Nulla viene salvato."

msgid "14 jours d’essai gratuit pour un premier abonnement"
msgstr "14 giorni di prova gratuita per un primo abbonamento"

msgid "Essayer gratuitement"
msgstr "Prova gratis"

msgid "L’essai gratuit devient automatiquement un abonnement payant à sa fin."
msgstr "La prova gratuita diventa automaticamente un abbonamento a pagamento alla sua scadenza."

msgid "%(days)s jours gratuits, puis"
msgstr "%(days)s giorni gratis, poi"

msgid "Voix de synthèse"
msgstr "Voce sintetica"

msgid "Votre essai Premium se termine dans %(num)d jour."
msgid_plural "Votre essai Premium se termine dans %(num)d jours."
msgstr[0] "La tua prova Premium termina tra %(num)d giorno."
msgstr[1] "La tua prova Premium termina tra %(num)d giorni."

msgid "%(num)d jour restant"
msgid_plural "%(num)d jours restants"
msgstr[0] "%(num)d giorno rimanente"
msgstr[1] "%(num)d giorni rimanenti"

msgid "%(num)d planification cette semaine"
msgid_plural "%(num)d planifications cette semaine"
msgstr[0] "%(num)d pianificazione questa settimana"
msgstr[1] "%(num)d pianificazioni questa settimana"

msgid "%(num)d page"
msgid_plural "%(num)d pages"
msgstr[0] "%(num)d pagina"
msgstr[1] "%(num)d pagine"

msgid "%(num)d note"
msgid_plural "%(num)d notes"
msgstr[0] "%(num)d voto"
msgstr[1] "%(num)d voti"
